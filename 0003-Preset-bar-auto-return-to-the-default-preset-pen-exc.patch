index 0000000..d7d0215
--- /dev/null
+++ b/src/common/components/preset-bar.js
@@ -0,0 +1,71 @@
+import React, { Fragment, useState } from 'react';
+import cx from 'classnames';
+import { presetForTool } from '../presets.mjs';
+
+// Lecture Pro: floating bar with one-tap annotation presets (heading, title, fact, bold, ...), the note/image/draw
+// tools and the "pen only" switch (pen annotates, finger scrolls). Hidden in read-only mode.
+function PresetBar({ tool, presets, readOnly, penExclusive, onChangeTool, onSetPenExclusive }) {
+	let [collapsed, setCollapsed] = useState(false);
+	if (readOnly) {
+		return null;
+	}
+
+	let active = presetForTool(presets, tool);
+
+	function presetButton(preset) {
+		return (
+			<button
+				key={preset.id}
+				type="button"
+				className={cx('preset', preset.tool, { active: active?.id === preset.id })}
+				style={{ '--preset-color': preset.color }}
+				title={preset.title}
+				aria-pressed={active?.id === preset.id}
+				onClick={() => onChangeTool({ type: preset.tool, color: preset.color })}
+			>{preset.label}</button>
+		);
+	}
+
+	function toolButton(type, label, title) {
+		return (
+			<button
+				type="button"
+				className={cx('preset', 'tool', { active: tool.type === type })}
+				title={title}
+				aria-pressed={tool.type === type}
+				onClick={() => onChangeTool({ type })}
+			>{label}</button>
+		);
+	}
+
+	return (
+		<div className={cx('preset-bar', { collapsed })} role="toolbar" aria-label="Annotation presets">
+			<button
+				type="button"
+				className="preset-collapse"
+				title={collapsed ? 'Show presets' : 'Hide presets'}
+				onClick={() => setCollapsed(!collapsed)}
+			>{collapsed ? '▴' : '▾'}</button>
+			{!collapsed && (
+				<Fragment>
+					<div className="preset-group">{presets.filter(p => p.tool === 'highlight').map(presetButton)}</div>
+					<div className="preset-group">{presets.filter(p => p.tool === 'underline').map(presetButton)}</div>
+					<div className="preset-group">
+						{toolButton('note', 'Note', 'Sticky note')}
+						{toolButton('image', 'Image', 'Image area')}
+						{toolButton('ink', 'Draw', 'Draw with the pen')}
+					</div>
+					<button
+						type="button"
+						className={cx('preset', 'pen-switch', { active: penExclusive })}
+						title="Pen only: the pen annotates, the finger scrolls and zooms"
+						aria-pressed={!!penExclusive}
+						onClick={() => onSetPenExclusive(!penExclusive)}
+					>Pen only</button>
+				</Fragment>
+			)}
+		</div>
+	);
+}
+
+export default PresetBar;
