diff --git a/src/common/stylesheets/components/_preset-bar.scss b/src/common/stylesheets/components/_preset-bar.scss
new file mode 100644
index 0000000..8b577fb
--- /dev/null
+++ b/src/common/stylesheets/components/_preset-bar.scss
@@ -0,0 +1,71 @@
+// Lecture Pro: floating preset bar (see components/preset-bar.js)
+.preset-bar {
+	position: fixed;
+	bottom: 14px;
+	left: 50%;
+	transform: translateX(-50%);
+	z-index: 5;
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: center;
+	gap: 6px 10px;
+	max-width: calc(100% - 24px);
+	padding: 6px 8px;
+	border-radius: 14px;
+	background: var(--material-toolbar);
+	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
+	user-select: none;
+	-webkit-user-select: none;
+
+	&.collapsed {
+		padding: 2px;
+	}
+
+	.preset-group {
+		display: flex;
+		gap: 4px;
+	}
+
+	.preset {
+		min-width: 44px; // large enough for pen and finger
+		height: 44px;
+		padding: 0 8px;
+		border: 2px solid transparent;
+		border-radius: 10px;
+		background: transparent;
+		color: var(--fill-primary);
+		font: 600 14px/1 sans-serif;
+		cursor: pointer;
+		touch-action: manipulation;
+
+		&.highlight {
+			background: var(--preset-color);
+			color: #1a1a1a;
+		}
+
+		&.underline {
+			box-shadow: inset 0 -6px 0 var(--preset-color);
+		}
+
+		&.active {
+			border-color: var(--accent-blue);
+		}
+
+		&.pen-switch.active {
+			background: var(--accent-blue);
+			color: #fff;
+		}
+	}
+
+	.preset-collapse {
+		width: 32px;
+		height: 44px;
+		border: 0;
+		border-radius: 10px;
+		background: transparent;
+		color: var(--fill-secondary);
+		font-size: 16px;
+		cursor: pointer;
+	}
+}
