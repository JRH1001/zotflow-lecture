+++ b/src/common/components/reader-ui.js
@@ -305,6 +305,7 @@ const ReaderUI = React.forwardRef((props, ref) => {
 						presets={state.presets}
 						readOnly={state.readOnly}
 						penExclusive={state.penExclusive}
+						position={state.presetBarPosition}
