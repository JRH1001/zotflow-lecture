 						onSetPenExclusive={props.onSetPenExclusive}
 					/>
diff --git a/src/common/presets.mjs b/src/common/presets.mjs
index 75bc6b5..747a5fb 100644
--- a/src/common/presets.mjs
+++ b/src/common/presets.mjs
@@ -67,3 +67,11 @@ export function presetAfterAnnotation({ presets, defaultId = DEFAULT_PRESET_ID,
 	}
 	return null;
 }
+
+// ---------- position of the preset bar ----------
+
+export const BAR_POSITIONS = ['bottom', 'top', 'left', 'right'];
+
+export function normalizeBarPosition(position) {
+	return BAR_POSITIONS.includes(position) ? position : 'bottom';
+}
diff --git a/src/common/reader.js b/src/common/reader.js
index 2c10fd6..08f1a03 100644
--- a/src/common/reader.js
+++ b/src/common/reader.js
@@ -40,7 +40,7 @@ import {
 } from './read-aloud/sdt-segments';
 import { createPositionMapper } from './sdt/create-position-mapper';
 import { isSDTPosition } from './types';
-import { DEFAULT_PRESET_ID, normalizePresets, presetAfterAnnotation } from './presets.mjs';
+import { DEFAULT_PRESET_ID, normalizeBarPosition, normalizePresets, presetAfterAnnotation } from './presets.mjs';
 import {
 	openStructuredDocumentTextPack,
 	SDT_PACK_VERSION,
@@ -255,6 +255,7 @@ class Reader {
 			// Lecture Pro: pen/finger, one-tap presets, back to the default preset after use
 			penExclusive: options.penExclusive ?? false,
 			presetBar: options.presetBar ?? false,
+			presetBarPosition: normalizeBarPosition(options.presetBarPosition),
 			presets: normalizePresets(options.presets),
 			defaultPresetId: options.defaultPresetId ?? DEFAULT_PRESET_ID,
 			autoReturnPreset: options.autoReturnPreset ?? false,
@@ -988,6 +989,10 @@ class Reader {
 		this._updateState({ presetBar: !!presetBar });
 	}
 
+	setPresetBarPosition(position) {
+		this._updateState({ presetBarPosition: normalizeBarPosition(position) });
+	}
+
 	setAutoReturnPreset(autoReturnPreset) {
 		this._updateState({ autoReturnPreset: !!autoReturnPreset });
 	}
diff --git a/src/common/stylesheets/components/_preset-bar.scss b/src/common/stylesheets/components/_preset-bar.scss
index 8b577fb..6bd6329 100644
--- a/src/common/stylesheets/components/_preset-bar.scss
+++ b/src/common/stylesheets/components/_preset-bar.scss
@@ -69,3 +69,43 @@
 		cursor: pointer;
 	}
 }
+
+// Position: bottom (default, see above), top, left, right
+.preset-bar {
+	&.pos-top {
+		top: 52px; // below the reader toolbar
+		bottom: auto;
+	}
+
+	&.pos-left,
+	&.pos-right {
+		top: 50%;
+		bottom: auto;
+		flex-direction: column;
+		flex-wrap: nowrap;
+		max-width: none;
+		max-height: calc(100% - 140px);
+		overflow-y: auto;
+
+		.preset-group {
+			flex-direction: column;
+		}
+
+		.preset-collapse {
+			width: 44px;
+			height: 32px;
+		}
+	}
+
+	&.pos-left {
+		left: 12px;
+		right: auto;
+		transform: translateY(-50%);
+	}
+
+	&.pos-right {
+		left: auto;
+		right: 12px;
+		transform: translateY(-50%);
+	}
+}
diff --git a/test/common/presets.test.mjs b/test/common/presets.test.mjs
index 574f77e..cf4bc36 100644
--- a/test/common/presets.test.mjs
+++ b/test/common/presets.test.mjs
@@ -61,3 +61,14 @@ test('normalizePresets keeps well-formed entries, adds titles, drops duplicates
 	assert.equal(normalizePresets([]), DEFAULT_PRESETS);
 	assert.equal(normalizePresets([{ id: 1 }]), DEFAULT_PRESETS);
 });
+
+test('bar position: bottom, top, left, right; anything else falls back to bottom', async () => {
+	const { BAR_POSITIONS, normalizeBarPosition } = await import('../../src/common/presets.mjs');
+	assert.deepEqual(BAR_POSITIONS, ['bottom', 'top', 'left', 'right']);
+	for (const p of BAR_POSITIONS) {
+		assert.equal(normalizeBarPosition(p), p);
+	}
+	for (const bad of [undefined, null, '', 'middle', 'LEFT', 5]) {
+		assert.equal(normalizeBarPosition(bad), 'bottom');
+	}
+});
