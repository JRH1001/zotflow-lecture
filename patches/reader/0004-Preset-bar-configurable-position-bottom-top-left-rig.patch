diff --git a/src/common/components/preset-bar.js b/src/common/components/preset-bar.js
index d7d0215..f984f8b 100644
--- a/src/common/components/preset-bar.js
+++ b/src/common/components/preset-bar.js
@@ -2,9 +2,17 @@ import React, { Fragment, useState } from 'react';
 import cx from 'classnames';
 import { presetForTool } from '../presets.mjs';
 
+// Arrow that points to the screen edge the bar sits at (open) / away from it (closed)
+const COLLAPSE_GLYPHS = {
+	bottom: { open: '▾', closed: '▴' },
+	top: { open: '▴', closed: '▾' },
+	left: { open: '◂', closed: '▸' },
+	right: { open: '▸', closed: '◂' },
+};
+
 // Lecture Pro: floating bar with one-tap annotation presets (heading, title, fact, bold, ...), the note/image/draw
 // tools and the "pen only" switch (pen annotates, finger scrolls). Hidden in read-only mode.
-function PresetBar({ tool, presets, readOnly, penExclusive, onChangeTool, onSetPenExclusive }) {
+function PresetBar({ tool, presets, readOnly, penExclusive, position = 'bottom', onChangeTool, onSetPenExclusive }) {
 	let [collapsed, setCollapsed] = useState(false);
 	if (readOnly) {
 		return null;
@@ -39,13 +47,13 @@ function PresetBar({ tool, presets, readOnly, penExclusive, onChangeTool, onSetP
 	}
 
 	return (
-		<div className={cx('preset-bar', { collapsed })} role="toolbar" aria-label="Annotation presets">
+		<div className={cx('preset-bar', `pos-${position}`, { collapsed })} role="toolbar" aria-label="Annotation presets">
 			<button
 				type="button"
 				className="preset-collapse"
 				title={collapsed ? 'Show presets' : 'Hide presets'}
 				onClick={() => setCollapsed(!collapsed)}
-			>{collapsed ? '▴' : '▾'}</button>
+			>{collapsed ? COLLAPSE_GLYPHS[position].closed : COLLAPSE_GLYPHS[position].open}</button>
 			{!collapsed && (
 				<Fragment>
 					<div className="preset-group">{presets.filter(p => p.tool === 'highlight').map(presetButton)}</div>
diff --git a/src/common/components/reader-ui.js b/src/common/components/reader-ui.js
