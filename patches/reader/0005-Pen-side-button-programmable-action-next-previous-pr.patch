diff --git a/src/common/pen-actions.mjs b/src/common/pen-actions.mjs
new file mode 100644
index 0000000..b3cf970
--- /dev/null
+++ b/src/common/pen-actions.mjs
@@ -0,0 +1,67 @@
+// Programmable action for the pen's side button. Pure logic (test/common/pen-actions.test.mjs); reader.js executes the result.
+
+import { presetById, presetForTool } from './presets.mjs';
+
+export const SIMPLE_PEN_ACTIONS = ['none', 'nextPreset', 'previousPreset', 'defaultPreset', 'eraser', 'pointer', 'penOnly'];
+
+/** 'preset:<id>' selects a specific preset. Unknown values become 'none'. */
+export function normalizePenAction(action, presets) {
+	if (SIMPLE_PEN_ACTIONS.includes(action)) {
+		return action;
+	}
+	if (typeof action === 'string' && action.startsWith('preset:') && presetById(presets, action.slice(7))) {
+		return action;
+	}
+	return 'none';
+}
+
+const toolOf = (preset) => ({ type: preset.tool, color: preset.color });
+
+/**
+ * What a press of the side button does now.
+ * Returns null (nothing to do), { type: 'penOnly' } (toggle pen-only mode) or
+ * { type: 'tool', tool, remember } - switch to `tool`; `remember` = keep the current tool so that pressing again
+ * (eraser / pointer toggle) can go back to it.
+ */
+export function resolvePenAction({ action, presets, defaultId, tool, previousTool }) {
+	const current = presetForTool(presets, tool);
+	const fallback = presetById(presets, defaultId) ?? presets[0];
+	// Where a toggle goes back to: the remembered tool, else the default preset, else the plain pointer
+	const backTo = previousTool && previousTool.type !== tool?.type ? previousTool : (fallback ? toolOf(fallback) : { type: 'pointer' });
+
+	switch (action) {
+		case 'penOnly':
+			return { type: 'penOnly' };
+
+		case 'nextPreset':
+		case 'previousPreset': {
+			if (!presets.length) {
+				return null;
+			}
+			const step = action === 'nextPreset' ? 1 : -1;
+			const index = current ? presets.indexOf(current) : (step === 1 ? -1 : 0);
+			const next = presets[(index + step + presets.length) % presets.length];
+			return { type: 'tool', tool: toolOf(next), remember: false };
+		}
+
+		case 'defaultPreset':
+			return fallback && current !== fallback ? { type: 'tool', tool: toolOf(fallback), remember: false } : null;
+
+		case 'eraser':
+		case 'pointer': {
+			// Toggle: first press switches to the tool, the next press returns to what was active before
+			if (tool?.type === action) {
+				return { type: 'tool', tool: backTo, remember: false };
+			}
+			return { type: 'tool', tool: { type: action }, remember: true };
+		}
+
+		default: {
+			if (typeof action === 'string' && action.startsWith('preset:')) {
+				const preset = presetById(presets, action.slice(7));
+				return preset && current !== preset ? { type: 'tool', tool: toolOf(preset), remember: false } : null;
+			}
+			return null; // 'none'
+		}
+	}
+}
diff --git a/src/common/pen-input.mjs b/src/common/pen-input.mjs
index 5fc3a0d..396c9df 100644
--- a/src/common/pen-input.mjs
+++ b/src/common/pen-input.mjs
@@ -9,6 +9,8 @@ export class PenInput {
 		this.exclusive = exclusive;
 		this._penDown = false;
 		this._busyUntil = 0;
+		this._lastButtons = 0;
+		this._lastBarrelAt = 0;
 	}
 
 	setExclusive(exclusive) {
@@ -28,6 +30,29 @@ export class PenInput {
 		}
 	}
 
+	/**
+	 * True once per press of the pen's side button: the rising edge of PointerEvent.buttons, whether the pen hovers
+	 * or touches the screen.
+	 */
+	barrelPressed(pointerType, buttons, now = Date.now()) {
+		if (pointerType !== 'pen') {
+			return false;
+		}
+		const down = (buttons & BARREL_BUTTON) !== 0;
+		const rising = down && (this._lastButtons & BARREL_BUTTON) === 0;
+		this._lastButtons = buttons;
+		if (!rising || now - this._lastBarrelAt < BUTTON_DEBOUNCE_MS) {
+			return false;
+		}
+		this._lastBarrelAt = now;
+		return true;
+	}
+
+	/** A context menu right after a side-button press belongs to that press (it should be suppressed if the button has an action). */
+	contextMenuFromBarrel(pointerType, now = Date.now()) {
+		return pointerType === 'pen' || now - this._lastBarrelAt < CONTEXT_MENU_GRACE_MS && this._lastBarrelAt > 0;
+	}
+
 	/** The pen touches the screen or has just been lifted. */
 	penBusy(now = Date.now()) {
 		return this._penDown || now < this._busyUntil;
@@ -69,3 +94,12 @@ export class PenInput {
 		return this.penBusy(now);
 	}
 }
+
+// ---------- the pen's side button ----------
+
+/** PointerEvent.buttons bit of the pen's side (barrel) button. */
+export const BARREL_BUTTON = 2;
+/** One physical press can produce several events: ignore repeats within this time. */
+export const BUTTON_DEBOUNCE_MS = 250;
+/** The browser may open a context menu for the side button a little after the press. */
+export const CONTEXT_MENU_GRACE_MS = 600;
