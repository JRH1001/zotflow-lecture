diff --git a/test/common/pen-actions.test.mjs b/test/common/pen-actions.test.mjs
new file mode 100644
index 0000000..dc3746f
--- /dev/null
+++ b/test/common/pen-actions.test.mjs
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { normalizePenAction, resolvePenAction } from '../../src/common/pen-actions.mjs';
+import { DEFAULT_PRESETS } from '../../src/common/presets.mjs';
+
+const P = DEFAULT_PRESETS;
+const run = (action, tool, previousTool) => resolvePenAction({ action, presets: P, defaultId: 'fact', tool, previousTool });
+const fact = { type: 'underline', color: '#ffd400' };
+const h1 = { type: 'highlight', color: '#ffd400' };
+
+test('normalizePenAction accepts the known actions and existing presets; everything else is "none"', () => {
+	for (const a of ['none', 'nextPreset', 'previousPreset', 'defaultPreset', 'eraser', 'pointer', 'penOnly', 'preset:bold']) {
+		assert.equal(normalizePenAction(a, P), a);
+	}
+	for (const bad of [undefined, '', 'nope', 'preset:', 'preset:unknown', 5]) {
+		assert.equal(normalizePenAction(bad, P), 'none');
+	}
+});
+
+test('none does nothing; penOnly toggles the mode', () => {
+	assert.equal(run('none', fact), null);
+	assert.deepEqual(run('penOnly', fact), { type: 'penOnly' });
+});
+
+test('next / previous preset cycle through the bar and wrap around', () => {
+	assert.deepEqual(run('nextPreset', h1), { type: 'tool', tool: { type: 'highlight', color: '#ff6666' }, remember: false }); // h1 -> h2
+	assert.deepEqual(run('previousPreset', h1), { type: 'tool', tool: { type: 'underline', color: '#a28ae5' }, remember: false }); // wraps to the last (question)
+	assert.deepEqual(run('nextPreset', { type: 'underline', color: '#a28ae5' }), { type: 'tool', tool: { type: 'highlight', color: '#ffd400' }, remember: false }); // last -> first
+	assert.equal(run('nextPreset', { type: 'pointer' }).tool.color, '#ffd400'); // no preset active: starts at the first
+	assert.equal(run('previousPreset', { type: 'pointer' }).tool.color, '#a28ae5'); // no preset active: previous starts at the last
+});
+
+test('default preset and specific presets; no-op when already active', () => {
+	assert.deepEqual(run('defaultPreset', h1), { type: 'tool', tool: fact, remember: false });
+	assert.equal(run('defaultPreset', fact), null);
+	assert.deepEqual(run('preset:definition', fact), { type: 'tool', tool: { type: 'underline', color: '#2ea8e5' }, remember: false });
+	assert.equal(run('preset:definition', { type: 'underline', color: '#2ea8e5' }), null);
+	assert.equal(run('preset:gone', fact), null);
+});
+
+test('eraser and pointer toggle: first press switches (and remembers), the next press goes back', () => {
+	assert.deepEqual(run('eraser', h1), { type: 'tool', tool: { type: 'eraser' }, remember: true });
+	assert.deepEqual(run('eraser', { type: 'eraser' }, h1), { type: 'tool', tool: h1, remember: false }); // back to the heading highlight
+	assert.deepEqual(run('eraser', { type: 'eraser' }), { type: 'tool', tool: fact, remember: false }); // nothing remembered: default preset
+	assert.deepEqual(run('pointer', fact), { type: 'tool', tool: { type: 'pointer' }, remember: true });
+	assert.deepEqual(run('pointer', { type: 'pointer' }, fact), { type: 'tool', tool: fact, remember: false });
+	assert.deepEqual(run('pointer', { type: 'pointer' }, { type: 'pointer' }), { type: 'tool', tool: fact, remember: false }); // stale memory is ignored
+});
+
+test('an empty preset list is harmless', () => {
+	assert.equal(resolvePenAction({ action: 'nextPreset', presets: [], defaultId: 'fact', tool: h1 }), null);
+	assert.equal(resolvePenAction({ action: 'defaultPreset', presets: [], defaultId: 'fact', tool: h1 }), null);
+	// toggles still work without presets: they go back to the plain pointer
+	assert.deepEqual(resolvePenAction({ action: 'eraser', presets: [], defaultId: 'fact', tool: { type: 'eraser' } }), { type: 'tool', tool: { type: 'pointer' }, remember: false });
+});
diff --git a/test/common/pen-input.test.mjs b/test/common/pen-input.test.mjs
index 12e752c..3a757a9 100644
--- a/test/common/pen-input.test.mjs
+++ b/test/common/pen-input.test.mjs
@@ -59,3 +59,28 @@ test('browsers without touchType: a single touch while a pen pointer is down cou
 	assert.equal(pen.isStylusTouch({ changedTouches: [{}], touches: [{}, {}] }), false);
 	assert.equal(pen.isStylusTouch(undefined), true); // no event details at all: trust the pointer state
 });
+
+test('side button: one callback per press (rising edge), hovering or touching, debounced, pen only', () => {
+	const pen = new PenInput();
+	assert.equal(pen.barrelPressed('pen', 0, 1000), false);
+	assert.equal(pen.barrelPressed('pen', 2, 2000), true); // press while hovering
+	assert.equal(pen.barrelPressed('pen', 2, 2100), false); // still held: no repeat
+	assert.equal(pen.barrelPressed('pen', 3, 2200), false); // pen touches down while the button is held: same press
+	assert.equal(pen.barrelPressed('pen', 0, 3000), false); // released
+	assert.equal(pen.barrelPressed('pen', 3, 4000), true); // next press, in contact with the screen
+	assert.equal(pen.barrelPressed('pen', 0, 4050), false);
+	assert.equal(pen.barrelPressed('pen', 2, 4100), false); // bounce within 250 ms is ignored
+	assert.equal(pen.barrelPressed('pen', 0, 4200), false);
+	assert.equal(pen.barrelPressed('pen', 2, 5000), true);
+	assert.equal(pen.barrelPressed('mouse', 2, 9000), false); // a mouse right-click is not the pen button
+	assert.equal(pen.barrelPressed('touch', 2, 9500), false);
+});
+
+test('a context menu from the side button is recognized (pen event, or shortly after a press)', () => {
+	const pen = new PenInput();
+	assert.equal(pen.contextMenuFromBarrel('pen', 100), true);
+	assert.equal(pen.contextMenuFromBarrel('mouse', 100), false); // no press yet: a real mouse right-click stays
+	pen.barrelPressed('pen', 2, 1000);
+	assert.equal(pen.contextMenuFromBarrel(undefined, 1300), true); // browser did not report the pointer type
+	assert.equal(pen.contextMenuFromBarrel('mouse', 1700), false);
+});
